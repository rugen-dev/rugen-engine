; rugen built-in arena stage, generated by `rugen stage-gen`
; Floating ink island with three platforms over a pit: no walls, 3 stocks,
; knock the opponent past a blast line (ARENA mode).
[Info]
name = "Ink Arena"
displayname = "Ink Arena"
author = "rugen"
mugenversion = 1.1

[Camera]
startx = 0
starty = 0
boundleft = -320
boundright = 320
boundhigh = -260
boundlow = 0
verticalfollow = 0.6
floortension = 20
tension = 70
zoomout = 0.5
zoomin = 1.15

[PlayerInfo]
p1startx = -90
p1starty = 0
p1facing = 1
p2startx = 90
p2starty = 0
p2facing = -1
leftbound = -1000
rightbound = 1000

[Bound]
screenleft = 15
screenright = 15

[StageInfo]
zoffset = 190
autoturn = 1
resetBG = 1
localcoord = 320, 240
xscale = 1
yscale = 1

[Shadow]
intensity = 120
color = 17,17,17
yscale = .25

[Reflection]
intensity = 0

[Arena]
; players crossing this box are KO'd (left, top, right, bottom)
blastzone = -520, -420, 520, 160
; no screen-edge walls: knockback carries players off the island
walls = 0
; lives per round
stocks = 3
; the island deck; beyond it is the pit down to the bottom blast line
floor = -240, 240
spawn_y = -140
air_jumps = 1
air_dash = 1
fast_fall = 1

[Platform]
x = -220, -80
y = -80

[Platform]
x = 80, 220
y = -80

[Platform]
x = -70, 70
y = -160

[Music]
bgmusic =
bgmvolume = 100

[BGdef]
