; rugen built-in arena stage, generated by `rugen stage-gen`
; Long floating ink island with nine platforms in three tiers over a pit: no
; walls, 3 stocks, knock the opponent past a blast line (ARENA mode).
[Info]
name = "Ink Arena"
displayname = "Ink Arena"
author = "rugen"
mugenversion = 1.1

[Camera]
startx = 0
starty = 0
boundleft = -760
boundright = 760
boundhigh = -360
boundlow = 0
verticalfollow = 0.6
floortension = 20
tension = 70
; far enough to show the whole island and the bottom blast line
zoomout = 0.25
zoomin = 1.15

[PlayerInfo]
p1startx = -160
p1starty = 0
p1facing = 1
p2startx = 160
p2starty = 0
p2facing = -1
leftbound = -2000
rightbound = 2000

[Bound]
screenleft = 15
screenright = 15

[StageInfo]
zoffset = 190
autoturn = 1
resetBG = 1
localcoord = 320, 240
xscale = 1
yscale = 1

[Shadow]
intensity = 120
color = 17,17,17
yscale = .25

[Reflection]
intensity = 0

[Arena]
; players crossing this box are KO'd (left, top, right, bottom)
blastzone = -920, -540, 920, 160
; no screen-edge walls: knockback carries players off the island
walls = 0
; lives per round
stocks = 3
; the island deck; beyond it is the pit down to the bottom blast line
floor = -640, 640
spawn_y = -140
air_jumps = 1
air_dash = 1
fast_fall = 1
; catch the deck's edges and climb back on (on by default with a floor)
ledge = 1
; pickups (a throwable, a heal, a power boost) every 10-20 s
items = 1

[Platform]
x = -540, -400
y = -80

[Platform]
x = -240, -100
y = -80

[Platform]
x = 100, 240
y = -80

[Platform]
x = 400, 540
y = -80

[Platform]
x = -390, -250
y = -160

[Platform]
x = -70, 70
y = -160

[Platform]
x = 250, 390
y = -160

[Platform]
x = -230, -90
y = -240

[Platform]
x = 90, 230
y = -240

