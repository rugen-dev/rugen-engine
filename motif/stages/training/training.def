; rugen built-in stage, generated by `rugen stage-gen`
; A very large room: the camera runs 1200 units each way, so the whole
; screen can be a fighter's dash. Floor ruler in stage units, 0 at centre.
[Info]
name = "Training Room EX"
displayname = "Training Room EX"
author = "rugen"
mugenversion = 1.1

[Camera]
startx = 0
starty = 0
boundleft = -1200
boundright = 1200
boundhigh = -700
boundlow = 0
verticalfollow = .25
floortension = 20
tension = 50
zoomout = 0.22
zoomin = 1.15
overdrawhigh = 0
overdrawlow = 0
cuthigh = 35
cutlow = 25

[PlayerInfo]
p1startx = -70
p1starty = 0
p1facing = 1
p2startx = 70
p2starty = 0
p2facing = -1
leftbound = -2600
rightbound = 2600

[Bound]
screenleft = 15
screenright = 15

[StageInfo]
zoffset = 190
autoturn = 1
resetBG = 1
localcoord = 320, 240
xscale = 1
yscale = 1

[Shadow]
intensity = 110
color = 0,0,0
yscale = .3

[Reflection]
intensity = 40

[Music]
bgmusic =
bgmvolume = 100

[BGdef]
spr = training.sff
debugbg = 0
bgclearcolor = 4,9,40

; horizon pulse: 4 s breathing
[Begin Action 10]
3,0, 0,0, 60
3,1, 0,0, 60
3,2, 0,0, 60
3,1, 0,0, 60

[BG far]
type = normal
spriteno = 0, 0
start = 0, -700
delta = .3, .3
tile = 1, 0
scalestart = .5, .5

[BG scan]
type = normal
spriteno = 1, 0
start = 0, -40
delta = .3, .3
velocity = 0, -0.25
tile = 1, 1
tilespacing = 0, 300
trans = add
scalestart = .5, .5

[BG wall]
type = normal
spriteno = 2, 0
start = 0, -232
delta = .7, .7
tile = 1, 0
scalestart = .5, .5

[BG horizon]
type = anim
actionno = 10
start = 0, 185
delta = 1, 1
trans = add
scalestart = .5, .5

[BG floor]
type = normal
spriteno = 4, 0
start = 0, 188
delta = 1, 1
tile = 1, 0
scalestart = .5, .5

[BG ruler]
type = normal
spriteno = 5, 0
start = 0, 191
delta = 1, 1
scalestart = .5, .5
